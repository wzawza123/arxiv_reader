# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Storage
DB_PATH=./data/arxiv.db
DATA_DIR=./data

# Scheduler (cron, server local time)
FETCH_CRON_HOUR=9
FETCH_CRON_MINUTE=0

# Background workers
WORKER_CONCURRENCY=2
SUMMARY_PDF_MAX_CHARS=60000

# arXiv fetch limits
FETCH_MAX_RESULTS_PER_QUERY=50
FETCH_LOOKBACK_DAYS=2
FETCH_CATEGORY_ALLOWLIST=cs.AI,cs.CL,cs.CV,cs.GR,cs.MA,cs.MM
FETCH_CATEGORY_PREFIX=cs.
